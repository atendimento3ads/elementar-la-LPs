Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Remove index.html da URL em uma única etapa, inclusive em acessos não canônicos.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]|$) [NC]
  RewriteRule ^(.*/)?index\.html$ https://elementarla.com.br/$1 [R=301,L,NE]

  RewriteRule ^(licenciamento-ambiental|licenciamento-ambiental-wp|licenciamento-ambiental-video|monitoramento-da-qualidade-do-ar)$ https://elementarla.com.br/$1/ [R=301,L,NE]
  RewriteRule ^$ https://elementarla.com.br/licenciamento-ambiental/ [R=301,L,NE]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^elementarla\.com\.br$ [NC]
  RewriteRule ^ https://elementarla.com.br%{REQUEST_URI} [R=301,L,NE]

  # A nova entrega é estática. Rotas conhecidas do WordPress não devem responder.
  RewriteRule ^2024/03/12/hello-world/?$ - [R=410,L,NC]
  RewriteRule ^(?:wp-admin|wp-includes|wp-content|wp-json)(?:/|$) - [R=410,L,NC]
  RewriteRule ^(?:wp-login\.php|xmlrpc\.php|wp-config\.php|wp-cron\.php|wp-load\.php|wp-settings\.php)$ - [R=410,L,NC]
  RewriteCond %{REQUEST_METHOD} !POST [NC]
  RewriteRule ^send-lead\.php$ - [R=405,L]
  RewriteCond %{REQUEST_URI} !^/send-lead\.php$ [NC]
  RewriteRule \.php$ - [R=410,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-t+nMas5kiGfMwggyZodjZwf9tujupaTyP+DLfVE3/WM=' 'sha256-ABe9tw1UZgL69aS5RGcQ1N4BcQMotssA06+hD0/+6qE=' 'sha256-BHPP0kNbPJGmMRWTaSOymuIXuaAxF2nEfck6CGjNHRg=' 'sha256-d2xQLSUfKKem47Mo0pg7T9Motb/e9FPyGVFJye5aZUA=' 'sha256-e+3LkezyfBbkcSSj/b7gjZdiKXFZZFCZaQEe62VJofk=' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.googleadservices.com https://www.google.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.clarity.ms https://*.clarity.ms https://s.tintim.app; style-src 'self'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://*.doubleclick.net https://www.google.com https://*.google.com https://*.google.com.br https://pagead2.googlesyndication.com https://www.googleadservices.com https://ssl.gstatic.com https://www.gstatic.com https://i.ytimg.com https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://*.doubleclick.net https://www.google.com https://*.google.com https://*.google.com.br https://pagead2.googlesyndication.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://*.clarity.ms https://c.bing.com; frame-src https://www.youtube-nocookie.com https://www.googletagmanager.com https://tagmanager.google.com https://td.doubleclick.net; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "send-lead.php">
    Header set Cache-Control "no-store"
    Header set Allow "POST"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
